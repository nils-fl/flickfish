{
  "configVersion": "v3",
  "app": {
    "appId": 1128637,
    "appName": "FlickFish",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "Nils Flaschel",
    "description": "Flick your wrist to cast, feel the bite, reel it in, fill your aquarium"
  },
  "permissions": [
    "device:os.local_storage",
    "device:os.accelerometer"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/lake/index",
            "page/aquarium/index"
          ]
        }
      },
      "platforms": [
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "FlickFish"
    }
  },
  "defaultLanguage": "en-US"
}
